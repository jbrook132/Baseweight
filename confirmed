<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>You're on the list — Baseweight</title>
<meta name="description" content="You're confirmed on the Baseweight waitlist. One email when it launches.">
<meta name="robots" content="noindex">
<link rel="icon" href="data:image/png;base64,">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">

<!--
  ═══════════════════════════════════════════════════════════════
  POST-CONFIRMATION PAGE
  Deploy to:  /confirmed/index.html   →   baseweight.live/confirmed
  Then in Kit, set the confirmation email's success/redirect URL to
  https://baseweight.live/confirmed

  YouTube link is live (@jackbrookes). The ?sub_confirmation=1 parameter
  opens the subscribe dialog automatically.
  ═══════════════════════════════════════════════════════════════
-->

<style>
  :root{
    --paper:#EDE6D6; --card:#F6F1E6; --ink:#26231C; --ink-soft:#6B6353;
    --line:#D6CAB1; --line-soft:#E3D9C4; --accent:#3A6B4F; --accent-deep:#2A4F3A; --pine:#2F4B3F;
    --sans:'Archivo',system-ui,-apple-system,sans-serif;
    --mono:'JetBrains Mono',ui-monospace,monospace;
  }
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  button,a{-webkit-tap-highlight-color:transparent;touch-action:manipulation}
  html{-webkit-text-size-adjust:100%}
  body{
    background:var(--paper);color:var(--ink);font-family:var(--sans);
    font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased;
    min-height:100vh;display:flex;flex-direction:column;overflow-x:hidden;
  }

  .topo{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;opacity:.16;z-index:0}
  .topo path{fill:none;stroke:var(--accent);stroke-width:1.2}

  .wrap{position:relative;z-index:1;width:100%;max-width:620px;margin:0 auto;padding:0 24px;flex:1;display:flex;flex-direction:column}

  /* ── hero lockup ── */
  .lockup{text-align:center;padding:58px 0 0}
  .lockup img{
    width:104px;height:104px;border-radius:24px;display:block;margin:0 auto 16px;
    box-shadow:0 14px 32px -16px rgba(38,35,28,.5);
  }
  .wordmark{font-size:clamp(38px,8.4vw,52px);font-weight:800;letter-spacing:-.035em;line-height:1;display:block}

  /* ── confirmation ── */
  .badge{
    display:inline-flex;align-items:center;gap:9px;margin:34px 0 20px;
    background:#E3ECE4;border:1px solid var(--accent);border-radius:100px;padding:8px 18px 8px 14px;
    font-family:var(--mono);font-size:11.5px;font-weight:700;letter-spacing:.14em;
    text-transform:uppercase;color:var(--accent-deep);
  }
  .badge svg{width:15px;height:15px;stroke:var(--accent);stroke-width:3;fill:none;stroke-linecap:round;stroke-linejoin:round}

  h1{font-size:clamp(40px,9vw,60px);line-height:1.02;letter-spacing:-.035em;font-weight:800;margin-bottom:18px;text-wrap:balance}
  h1 i{font-style:normal;color:var(--accent)}
  .lede{font-size:18px;color:var(--ink-soft);max-width:44ch;text-wrap:pretty}

  .middle{text-align:center;padding:8px 0 0;display:flex;flex-direction:column;align-items:center}

  /* ── what happens next ── */
  .next{
    width:100%;background:var(--card);border:1px solid var(--line);border-radius:16px;
    margin:38px 0 0;padding:6px 20px;text-align:left;
  }
  .next-row{display:grid;grid-template-columns:auto 1fr;gap:15px;align-items:start;padding:17px 0;border-bottom:1px solid var(--line-soft)}
  .next-row:last-child{border-bottom:0}
  .next-row .k{
    font-family:var(--mono);font-size:10.5px;font-weight:700;letter-spacing:.12em;
    text-transform:uppercase;color:var(--accent);width:74px;padding-top:3px;
  }
  .next-row .v{font-size:15.5px;line-height:1.5}
  .next-row .v b{display:block;margin-bottom:2px}
  .next-row .v span{color:var(--ink-soft)}

  /* ── secondary cta ── */
  .aside{margin:36px 0 0;width:100%;text-align:center}
  .aside p{font-size:15.5px;color:var(--ink-soft);margin-bottom:16px;text-wrap:pretty}
  .btn{
    display:inline-flex;align-items:center;gap:10px;
    font-family:var(--sans);font-size:16px;font-weight:700;text-decoration:none;
    color:var(--card);background:var(--accent);border-radius:11px;padding:14px 24px;
    transition:background .18s,transform .1s;
  }
  .btn:hover{background:var(--accent-deep)}
  .btn:active{transform:translateY(1px)}
  .btn:focus-visible{outline:2px solid var(--accent-deep);outline-offset:3px}
  .btn svg{width:19px;height:19px;fill:currentColor}

  footer{
    position:relative;z-index:1;text-align:center;padding:52px 24px 44px;
    font-family:var(--mono);font-size:11.5px;color:#8A8271;line-height:1.7;
  }
  footer b{display:block;font-family:var(--sans);font-size:13.5px;font-weight:600;color:var(--ink-soft);margin-bottom:5px}

  @media (min-width:620px){
    .lockup{padding-top:72px}
    .lockup img{width:120px;height:120px;border-radius:27px}
    .next{padding:6px 26px}
  }
  @media (prefers-reduced-motion:no-preference){
    .lockup,.middle{animation:rise .6s cubic-bezier(.2,.8,.3,1) both}
    .middle{animation-delay:.12s}
    @keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
  }
</style>
</head>
<body>

<svg class="topo" id="topo" viewBox="0 0 620 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true"></svg>

<div class="wrap">

  <div class="lockup">
    <img src="data:image/png;base64," alt="Baseweight" width="120" height="120">
    <span class="wordmark">Baseweight</span>
  </div>

  <div class="middle">
    <span class="badge">
      <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
      Confirmed
    </span>

    <h1>You're on <i>the list.</i></h1>
    <p class="lede">That's it — nothing else to do. I'll email you the day Baseweight goes live.</p>

    <div class="next">
      <div class="next-row">
        <span class="k">Next</span>
        <span class="v"><b>One email, at launch</b><span>No countdown, no drip sequence, no daily thoughts on the philosophy of ultralight backpacking.</span></span>
      </div>
      <div class="next-row">
        <span class="k">What for</span>
        <span class="v"><b>A gear list app that shows you where the weight is</b><span>500+ items with weights loaded, a packing checklist, and a breakdown that finds the heavy stuff you'd never have guessed.</span></span>
      </div>
      <div class="next-row">
        <span class="k">Cost</span>
        <span class="v"><b>Free</b><span>Phone and desktop. Works offline.</span></span>
      </div>
    </div>

    <div class="aside">
      <p>In the meantime — I make no-BS videos about hiking, backpacking and the gear that actually works on the trail.</p>
      <a class="btn" href="https://www.youtube.com/@jackbrookes?sub_confirmation=1" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.5 15.6V8.4l6.3 3.6-6.3 3.6z"/></svg>
        Watch on YouTube
      </a>
    </div>
  </div>

</div>

<footer>
  <b>Jack Brookes — No-BS Hiking</b>
  Physiotherapist, hiker, weigher of unreasonable numbers of things.
</footer>

<script>
(function(){
  var svg=document.getElementById("topo");
  if(!svg) return;
  var NS="http://www.w3.org/2000/svg";
  function range(cx,cy,rings,rmin,step,seed,squash){
    for(var i=0;i<rings;i++){
      var r=rmin+i*step, pts=[], a=0;
      for(a=0;a<Math.PI*2+0.01;a+=Math.PI/48){
        var rr=r*(1+0.11*Math.sin(a*2+seed)+0.07*Math.sin(a*3+seed*3)+0.045*Math.sin(a*5+seed*1.9));
        pts.push((cx+Math.cos(a)*rr*squash).toFixed(1)+","+(cy+Math.sin(a)*rr).toFixed(1));
      }
      var p=document.createElementNS(NS,"path");
      p.setAttribute("d","M"+pts.join("L")+"Z");
      svg.appendChild(p);
    }
  }
  range(600,120,10,30,42,0.7,1.3);
  range(20,900,9,34,46,2.4,1.4);
})();
</script>
</body>
</html>
